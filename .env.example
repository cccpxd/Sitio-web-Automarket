# Local development only. Never commit a real .env file.
# Vercel injects PORT automatically; do not define it there.

APP_ENV=development
PORT=8080

# PostgreSQL. Use a pooled URL in production (Neon pooler, Supabase pooler, etc.).
# In production use sslmode=require; APP_ENV=production rejects sslmode=disable.
DATABASE_URL=postgres://user:password@localhost:5432/automarket?sslmode=disable
DB_MAX_OPEN_CONNS=5
DB_MAX_IDLE_CONNS=2
DB_CONN_MAX_LIFETIME=5m
DB_CONNECT_TIMEOUT=10s

# Sessions
SESSION_TTL=24h
COOKIE_NAME=session_token
# Must be false only for plain HTTP local development.
COOKIE_SECURE=false

# Optional bootstrap administrator. Both values or neither.
# On Vercel use a strong password of at least 12 characters.
ADMIN_NAME=Administrador
ADMIN_EMAIL=
ADMIN_PASSWORD=

LOG_LEVEL=info
